<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#3D6EF7" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3D6EF7" />
            <SolidColorBrush x:Key="AccentSoft2Brush" Color="#333D6EF7" />
            <Style x:Key="LpGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
            <Style x:Key="LpPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style x:Key="LpCaptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
        </Grid.Resources>

        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏：小品牌点 + 窗口名 + 关闭 -->
                <Grid x:Name="CaptionBar" Background="{ThemeResource CaptionBrush}">
                    <Grid Padding="14,0,8,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CaptionDot" Width="15" Height="15" CornerRadius="5">
                            <TextBlock x:Name="CaptionMarkText"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="检查更新"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource Text2Brush}"
                                   VerticalAlignment="Center" />

                        <Border x:Name="PreviewBadge"
                                Grid.Column="3"
                                Background="{ThemeResource Surface3Brush}"
                                CornerRadius="10"
                                Padding="7,2"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock Text="预览 · 测试注入"
                                       FontSize="9"
                                       Foreground="{ThemeResource WarnBrush}" />
                        </Border>

                        <Button Grid.Column="4"
                                Style="{StaticResource LpCaptionButtonStyle}"
                                ToolTipService.ToolTip="关闭"
                                Click="OnCloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource Border1Brush}" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 常驻态：居中品牌、当前版本、上次检查 -->
                    <StackPanel x:Name="IdlePanel"
                                Padding="18,0,18,0"
                                VerticalAlignment="Center"
                                Spacing="9"
                                HorizontalAlignment="Center">
                        <Border x:Name="IdleMark" Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Center">
                            <TextBlock x:Name="IdleMarkText"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="IdleProductText"
                                   Text="Pathleap"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Text1Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="IdleVersionText"
                                   Text="当前版本 1.0.1"
                                   FontSize="10"
                                   Foreground="{ThemeResource Text3Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="IdleLastText"
                                   Text="上次检查：尚未检查"
                                   FontSize="9"
                                   Foreground="{ThemeResource Text4Brush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 发现新版本 -->
                    <Grid x:Name="FoundPanel"
                          Padding="18,16,18,0"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FoundMark" Width="26" Height="26" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock x:Name="FoundMarkText"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <Border Background="{ThemeResource AccentSoftBrush}"
                                        BorderBrush="{ThemeResource AccentSoft2Brush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="6,2"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="发现新版本" FontSize="8.5" Foreground="{ThemeResource AccentBrush}" CharacterSpacing="30" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock x:Name="FoundVersionText"
                                               Text="1.0.2"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Text1Brush}" />
                                    <TextBlock x:Name="FoundOldText"
                                               Text="1.0.1"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource Text4Brush}"
                                               TextDecorations="Strikethrough"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,2" />
                                    <Border BorderBrush="{ThemeResource Border2Brush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="FoundChannelText"
                                                   Text="稳定通道"
                                                   FontSize="8.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="NotesPanel"
                                Grid.Row="1"
                                Background="{ThemeResource Surface2Brush}"
                                BorderBrush="{ThemeResource Border1Brush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="9,8"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="更新说明"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{ThemeResource Text3Brush}" />
                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="92"
                                              Margin="0,5,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="NotesText"
                                               FontSize="9.5"
                                               LineHeight="15"
                                               Foreground="{ThemeResource Text2Brush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid x:Name="MirrorPanel"
                              Grid.Row="2"
                              Margin="0,9,0,0"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MirrorLabelText"
                                       Grid.Column="1"
                                       Text="下载源"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource Text2Brush}"
                                       VerticalAlignment="Center" />
                            <!-- 不再保留点了没效果的镜像下拉：只有 github.com 直链才显示「官方直链」，
                                 其它来源直接说明镜像不可用（文案由代码按资产 host 设置）。 -->
                            <TextBlock x:Name="MirrorStatusText"
                                       Grid.Column="2"
                                       Text="GitHub 官方直链"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource Text3Brush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="AssetInfoText"
                                   Grid.Row="3"
                                   FontSize="8.5"
                                   Foreground="{ThemeResource Text4Brush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Bottom"
                                   Margin="0,4,0,4"
                                   Visibility="Collapsed" />
                    </Grid>

                    <!-- 下载中 -->
                    <Grid x:Name="DownloadPanel"
                          Padding="18,0,18,0"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Border Background="{ThemeResource Surface2Brush}"
                                BorderBrush="{ThemeResource Border1Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,10">
                            <StackPanel Spacing="0">
                                <Grid ColumnSpacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DownloadTitleText"
                                                   Text="正在下载 1.0.2"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource Text2Brush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="ProgressText"
                                               Text="0%"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas"
                                               Foreground="{ThemeResource Text1Brush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="5" CornerRadius="3" Background="{ThemeResource Surface4Brush}" Margin="0,8,0,7">
                                    <Border x:Name="ProgressFill" Height="5" CornerRadius="3" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" Width="0" />
                                </Border>
                                <TextBlock x:Name="ProgressDetailText" Text="" FontSize="8.5" Foreground="{ThemeResource Text3Brush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 仅下载完成 -->
                    <StackPanel x:Name="DownloadedPanel"
                                Padding="18,0,18,0"
                                VerticalAlignment="Center"
                                Spacing="13"
                                Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Border x:Name="DownloadedMark" Width="40" Height="40" CornerRadius="11">
                                <FontIcon Glyph="&#xE73E;" FontSize="19" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="DownloadedTitleText"
                                           Text="1.0.2 已下载完成"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock x:Name="DownloadedSubText"
                                           Text="仅下载模式，未执行安装"
                                           FontSize="10"
                                           Foreground="{ThemeResource Text3Brush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{ThemeResource Surface2Brush}"
                                BorderBrush="{ThemeResource Border1Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,9">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="6" Background="#1F3FAE95">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#3FAE95" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="DownloadedFileName"
                                               Text="Pathleap-1.0.2-setup.exe"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource Text1Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DownloadedFileDetail"
                                               Text=""
                                               FontSize="8.5"
                                               Foreground="{ThemeResource Text3Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource OkBrush}" />
                                    <TextBlock Text="已完成" FontSize="8.5" Foreground="{ThemeResource OkBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 底部按钮：打开主页 / 检查更新 / 仅下载 / 更新 / 安装 -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource Surface2Brush}"
                            BorderBrush="{ThemeResource Border1Brush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,11">
                        <Grid ColumnSpacing="7">
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Left">
                                <Button x:Name="HomeButton"
                                        Content="打开主页"
                                        Style="{StaticResource LpGhostButtonStyle}"
                                        Click="OnHomeClick" />
                                <Button x:Name="OpenFolderButton"
                                        Content="打开下载目录"
                                        Style="{StaticResource LpGhostButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OnOpenFolderClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                <Button x:Name="CheckButton"
                                        Content="检查更新"
                                        Style="{StaticResource LpGhostButtonStyle}"
                                        Click="OnCheckClick" />
                                <Button x:Name="DownloadOnlyButton"
                                        Content="仅下载"
                                        Style="{StaticResource LpGhostButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OnDownloadOnlyClick" />
                                <Button x:Name="UpdateButton"
                                        Content="更新"
                                        Style="{StaticResource LpPrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OnUpdateClick" />
                                <Button x:Name="InstallButton"
                                        Content="安装"
                                        Style="{StaticResource LpPrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OnInstallClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
