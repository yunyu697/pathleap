<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pathleap.UI.Controls.LpSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Track"
            Width="36"
            Height="20"
            CornerRadius="10"
            Background="{ThemeResource Surface4Brush}"
            BorderBrush="{ThemeResource Border2Brush}"
            BorderThickness="1"
            Tapped="OnTapped">
        <Ellipse x:Name="Thumb"
                 Width="14"
                 Height="14"
                 Fill="White"
                 HorizontalAlignment="Left"
                 Margin="3,0,0,0" />
    </Border>
</UserControl>
