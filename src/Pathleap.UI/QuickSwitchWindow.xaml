<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Pathleap.UI.QuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid x:Name="RootGrid" Background="Transparent">
    <!-- 快速切换栏：吸附在文件对话框底边，半宽居中；无输入时是最近文件夹，有输入时是搜索结果。 -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderThickness="1">
        <Grid Padding="12,7,12,8" RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BrandDot"
                        Width="20"
                        Height="20"
                        CornerRadius="5"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="快速切换"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="9.5"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="CountText"
                           Grid.Column="2"
                           FontSize="9.5"
                           VerticalAlignment="Center" />

                <Border x:Name="HintChip"
                        Grid.Column="3"
                        Padding="7,2,7,2"
                        CornerRadius="8"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ModeHintText"
                               FontSize="9"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <TextBox x:Name="SearchBox"
                     Grid.Row="1"
                     Height="26"
                     Padding="8,0,8,0"
                     FontSize="11.5"
                     VerticalContentAlignment="Center"
                     BorderThickness="1"
                     CornerRadius="7"
                     PlaceholderText="搜索文件与文件夹"
                     IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False" />

            <Grid Grid.Row="2">
                <Grid x:Name="ChipsPanel" ColumnSpacing="5" RowSpacing="4" />
                <StackPanel x:Name="ResultsPanel" Spacing="3" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyText"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
