<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.QuickSwitchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#3D6EF7" />
            <Style x:Key="LpQsKbdStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="15" />
                <Setter Property="Height" Value="15" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="LpQsKbdTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="8.5" />
                <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="13,12,13,11" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BrandDot"
                            Width="28"
                            Height="28"
                            CornerRadius="7"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="14"
                                  Foreground="{ThemeResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="快速切换"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Text1Brush}" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="已打开的文件夹"
                                   FontSize="9.5"
                                   Foreground="{ThemeResource Text3Brush}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            BorderBrush="{ThemeResource Border2Brush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText"
                                   Text="0 个窗口"
                                   FontSize="9.5"
                                   Foreground="{ThemeResource Text3Brush}" />
                    </Border>
                </Grid>

                <StackPanel x:Name="RowsPanel" Grid.Row="1" Margin="8,0,8,4" Spacing="1" />

                <Button x:Name="KeySink"
                        Width="1" Height="1"
                        Opacity="0"
                        IsTabStop="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />

                <Border Grid.Row="2"
                        Height="34"
                        Background="{ThemeResource Surface2Brush}"
                        BorderBrush="{ThemeResource Border1Brush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                    <Grid Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="↑" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="↓" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <TextBlock Text="选择" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="1" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <TextBlock Text="–" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="6" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <TextBlock Text="直选" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="↵" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <TextBlock Text="跳转" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Width="1" Height="10" Background="{ThemeResource Border2Brush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Style="{StaticResource LpQsKbdStyle}"><TextBlock Text="Esc" Style="{StaticResource LpQsKbdTextStyle}" /></Border>
                                <TextBlock Text="取消" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyHintText"
                                       Text="还没有打开记录"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource Text4Brush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="PreviewBadgeText"
                                       Text="未接入文件对话框"
                                       FontSize="9"
                                       Foreground="{ThemeResource Text4Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
