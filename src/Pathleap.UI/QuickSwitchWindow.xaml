<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Pathleap.UI.QuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid x:Name="RootGrid" Background="Transparent">
    <!-- 快速切换栏：吸附在文件对话框底边，半宽居中；不激活、不抢焦点。 -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderThickness="1">
        <Grid Padding="12,7,12,8" RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BrandDot"
                        Width="20"
                        Height="20"
                        CornerRadius="5"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="快速切换"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="9.5"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="9.5" VerticalAlignment="Center" />
                    <Border x:Name="HintChip"
                            Padding="7,2,7,2"
                            CornerRadius="8"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ModeHintText"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="ChipsPanel" Grid.Row="1" ColumnSpacing="5" RowSpacing="4" />
        </Grid>
    </Border>
</Grid>
</Window>
