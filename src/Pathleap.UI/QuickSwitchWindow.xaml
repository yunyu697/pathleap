<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.QuickSwitchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#3D6EF7" />
        </Grid.Resources>
        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="13,12,13,11" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BrandDot"
                            Width="28"
                            Height="28"
                            CornerRadius="7"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="14"
                                  Foreground="{ThemeResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="快速切换"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Text1Brush}" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="已打开的文件夹"
                                   FontSize="9.5"
                                   Foreground="{ThemeResource Text3Brush}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            BorderBrush="{ThemeResource Border2Brush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText"
                                   Text="0 个窗口"
                                   FontSize="9.5"
                                   Foreground="{ThemeResource Text3Brush}" />
                    </Border>
                </Grid>

                <StackPanel x:Name="RowsPanel" Grid.Row="1" Margin="8,0,8,4" Spacing="1" />

                <Button x:Name="KeySink"
                        Width="1" Height="1"
                        Opacity="0"
                        IsTabStop="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />

                <Border Grid.Row="2"
                        Height="34"
                        Background="{ThemeResource Surface2Brush}"
                        BorderBrush="{ThemeResource Border1Brush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                    <Grid Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="1–6 直选" FontSize="10" Foreground="{ThemeResource Text3Brush}" />
                            <TextBlock Text="↵ 打开" FontSize="10" Foreground="{ThemeResource Text3Brush}" />
                            <TextBlock Text="Esc 关闭" FontSize="10" Foreground="{ThemeResource Text3Brush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyHintText"
                                       Text="还没有打开记录"
                                       FontSize="10"
                                       Foreground="{ThemeResource Text4Brush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="PreviewBadgeText"
                                       Text="预览 · 未接入对话框注入"
                                       FontSize="9"
                                       Foreground="{ThemeResource WarnBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
