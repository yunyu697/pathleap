<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pathleap.UI</RootNamespace>
    <AssemblyName>Pathleap.UI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 使用自建 Program.Main，才能在任何 WinUI 初始化之前完成单实例判定 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>Pathleap.UI.Program</StartupObject>
    <ApplicationIcon>Assets\Pathleap.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配色方案数据：嵌入程序集，运行期读取；tools/Test-LpThemeContrast.ps1 也直接读这份源文件。 -->
    <EmbeddedResource Include="Theme\ColorThemes.json">
      <LogicalName>Pathleap.UI.ColorThemes.json</LogicalName>
    </EmbeddedResource>
    <!-- 暗色版：嵌入 exe 资源（资源管理器/任务栏/托盘/安装包/快捷方式用），并复制到输出目录。 -->
    <Content Include="Assets\Pathleap.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 界面内标记：亮/暗各一份，运行期按实际生效的明暗切换。 -->
    <Content Include="Assets\pathleap-mark-dark.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\pathleap-mark-light.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pathleap.Shared\Pathleap.Shared.csproj" />
  </ItemGroup>
</Project>
