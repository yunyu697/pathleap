                                <TextBlock Text="全局热键" Style="{StaticResource LpSectionLabelStyle}" Margin="0,20,0,6" />
                                <TextBlock FontSize="11.5"
                                           Foreground="{ThemeResource Text2Brush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Text="唤出 / 隐藏搜索框：双击 Ctrl（可在「快捷键」页换成其它预置）。快速切换栏：Ctrl + G。热键冲突时以系统级热键优先，修改预置后立即生效。" />

                                <TextBlock Text="索引与权限" Style="{StaticResource LpSectionLabelStyle}" Margin="0,20,0,6" />
                                <TextBlock FontSize="11.5"
                                           Foreground="{ThemeResource Text2Brush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Text="索引在后台建立，检测到变更后重建；当前索引范围固定为单个卷的根目录，不提供目录增删。目录越多首次索引越久，但不影响搜索窗口先打开。以标准权限运行时，标准权限的文件对话框可正常注入；提权进程受 Windows UIPI 限制，普通权限窗口不能向提权对话框注入路径。" />

                                <TextBlock Text="更新检查" Style="{StaticResource LpSectionLabelStyle}" Margin="0,20,0,6" />
                                <TextBlock FontSize="11.5"
                                           Foreground="{ThemeResource Text2Brush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Text="在「更新」页手动检查 GitHub 上的最新版本；也可以在设置里开启启动时自动检查。检查只做一次版本查询，不会自动下载或安装。" />

                                <Border Background="{ThemeResource Surface3Brush}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,22,0,0">
                                    <TextBlock FontSize="10.5"
                                               Foreground="{ThemeResource Text3Brush}"
                                               TextWrapping="Wrap"
                                               LineHeight="17"
                                               Text="首次使用引导只在第一次打开时出现；看过或点过「跳过」后写入设置，不再重复。重置设置或重装后会重新出现。" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
