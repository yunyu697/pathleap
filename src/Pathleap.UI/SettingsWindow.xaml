<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pathleap.UI.Controls">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#3D6EF7" />
            <Style x:Key="LpNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="10,1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="LpSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
            </Style>
            <Style x:Key="LpKbdStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="{ThemeResource Surface3Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="LpGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
            <Style x:Key="LpPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource Surface4Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style x:Key="LpSelectButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
            <Style x:Key="LpCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border1Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏（系统按钮由 WinUI 绘制在右侧） -->
                <Grid x:Name="CaptionBar" Grid.Row="0" Background="{ThemeResource CaptionBrush}">
                    <TextBlock Text="设置"
                               FontSize="12.5"
                               Foreground="{ThemeResource Text2Brush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Height="1"
                            Background="{ThemeResource Border1Brush}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧分类 -->
                    <Border Background="{ThemeResource Surface2Brush}"
                            BorderBrush="{ThemeResource Border1Brush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Padding="16,16,16,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BrandDot"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="BrandMarkText"
                                               Text="名"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="ProductNameText"
                                               Text="Pathleap"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Text1Brush}" />
                                    <TextBlock Text="设置"
                                               FontSize="10"
                                               Foreground="{ThemeResource Text3Brush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <Button x:Name="NavAppearance"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavAppearanceClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                                        <TextBlock Text="外观与主题" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="行为"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="20,14,0,5" />

                                <Button x:Name="NavShortcuts"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavShortcutsClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE765;" FontSize="14" />
                                        <TextBlock Text="快捷键" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavScope"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavScopeClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="搜索范围与索引" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="系统"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="20,14,0,5" />

                                <Button x:Name="NavUpdate"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavUpdateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="更新" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="16,0,16,14" Spacing="3">
                                <TextBlock x:Name="NavVersionText"
                                           Text="版本 1.0.1"
                                           FontSize="10.5"
                                           Foreground="{ThemeResource Text3Brush}" />
                                <Button Content="检查更新"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        FontSize="10.5"
                                        Foreground="{ThemeResource Text2Brush}"
                                        HorizontalAlignment="Left"
                                        Click="OnCheckUpdateClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧内容 -->
                    <ScrollViewer Grid.Column="1"
                                  x:Name="ContentScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Padding="26,18,26,26">
                            <!-- 外观与主题 -->
                            <StackPanel x:Name="PageAppearance">
                                <TextBlock Text="外观与主题"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="跟随系统观感，只保留真正影响效率的个性化。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

                                <TextBlock Text="主题"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,9" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ThemeLightCard"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeLightTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6" Background="#F1F4F9">
                                                <Border Width="104" Height="54"
                                                        Background="#FFFFFF"
                                                        CornerRadius="5"
                                                        BorderBrush="#1A101828"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Margin="9,8,9,7" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <Ellipse Width="5" Height="5" Fill="#3D6EF7" />
                                                            <Ellipse Width="5" Height="5" Fill="#C9CFDA" />
                                                            <Ellipse Width="5" Height="5" Fill="#C9CFDA" />
                                                        </StackPanel>
                                                        <Border Height="6" Width="62" CornerRadius="2" Background="#DDE3ED" HorizontalAlignment="Left" />
                                                        <Border Height="6" Width="38" CornerRadius="2" Background="#E9EDF3" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="浅色" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeLightRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ThemeDarkCard"
                                            Grid.Column="1"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeDarkTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6" Background="#171A21">
                                                <Border Width="104" Height="54"
                                                        Background="#1E222A"
                                                        CornerRadius="5"
                                                        BorderBrush="#26FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Margin="9,8,9,7" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <Ellipse Width="5" Height="5" Fill="#3D6EF7" />
                                                            <Ellipse Width="5" Height="5" Fill="#4A5160" />
                                                            <Ellipse Width="5" Height="5" Fill="#4A5160" />
                                                        </StackPanel>
                                                        <Border Height="6" Width="62" CornerRadius="2" Background="#343B49" HorizontalAlignment="Left" />
                                                        <Border Height="6" Width="38" CornerRadius="2" Background="#2A303C" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="深色" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeDarkRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ThemeSystemCard"
                                            Grid.Column="2"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeSystemTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F1F4F9" Offset="0" />
                                                        <GradientStop Color="#F1F4F9" Offset="0.5" />
                                                        <GradientStop Color="#171A21" Offset="0.5" />
                                                        <GradientStop Color="#171A21" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Border Width="58" Height="44" Background="#FFFFFF" CornerRadius="4" BorderBrush="#1A101828" BorderThickness="1" HorizontalAlignment="Left" Margin="16,10,0,0" VerticalAlignment="Center">
                                                        <StackPanel Margin="6,6" Spacing="3">
                                                            <Border Height="5" Width="34" CornerRadius="2" Background="#DDE3ED" HorizontalAlignment="Left" />
                                                            <Border Height="5" Width="24" CornerRadius="2" Background="#E9EDF3" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Width="58" Height="44" Background="#1E222A" CornerRadius="4" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Right" Margin="0,10,16,0" VerticalAlignment="Center">
                                                        <StackPanel Margin="6,6" Spacing="3">
                                                            <Border Height="5" Width="34" CornerRadius="2" Background="#343B49" HorizontalAlignment="Left" />
                                                            <Border Height="5" Width="24" CornerRadius="2" Background="#2A303C" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="跟随系统" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeSystemRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="强调色"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,9" />
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Border x:Name="AccentBlue" Width="21" Height="21" CornerRadius="11" Background="#3D6EF7" Tapped="OnAccentTapped" Tag="#3D6EF7">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="AccentPurple" Width="21" Height="21" CornerRadius="11" Background="#7A5CFF" Tapped="OnAccentTapped" Tag="#7A5CFF">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="AccentGreen" Width="21" Height="21" CornerRadius="11" Background="#2FA27F" Tapped="OnAccentTapped" Tag="#2FA27F">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="AccentAmber" Width="21" Height="21" CornerRadius="11" Background="#D98A2B" Tapped="OnAccentTapped" Tag="#D98A2B">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="AccentRed" Width="21" Height="21" CornerRadius="11" Background="#D9536F" Tapped="OnAccentTapped" Tag="#D9536F">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="强调色会同步到选中态与高亮片段"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource Text4Brush}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="窗口"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,9" />
                                <Grid ColumnSpacing="12" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="窗口不透明度" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="降低透明度可让桌面内容透出，建议搭配磨砂背景"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSlider x:Name="OpacitySlider"
                                                       Grid.Column="1"
                                                       Width="110"
                                                       VerticalAlignment="Center"
                                                       ValueChanged="OnOpacityChanged" />
                                    <TextBlock x:Name="OpacityValueText"
                                               Grid.Column="2"
                                               Text="92%"
                                               FontSize="11"
                                               Foreground="{ThemeResource Text2Brush}"
                                               MinWidth="34"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="12" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="磨砂背景" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="从壁纸采样颜色，减少纯色窗口的割裂感"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="AcrylicSwitch"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Toggled="OnAcrylicToggled" />
                                </Grid>

                                <Grid ColumnSpacing="12" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="结果列表密度" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="紧凑模式显示更多结果，标准模式保留路径行"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource Surface2Brush}"
                                            BorderBrush="{ThemeResource Border2Brush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Border x:Name="DensityCompact" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Compact">
                                                <TextBlock Text="紧凑" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                            <Border x:Name="DensityStandard" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Standard">
                                                <TextBlock Text="标准" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                            <Border x:Name="DensityComfortable" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Comfortable">
                                                <TextBlock Text="宽松" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 快捷键 -->
                            <StackPanel x:Name="PageShortcuts" Visibility="Collapsed">
                                <TextBlock Text="快捷键"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="全部操作可脱离鼠标完成。冲突时以系统级热键优先。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

                                <TextBlock Text="全局" Style="{StaticResource LpSectionLabelStyle}" Margin="0,22,0,6" />
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="唤出 / 隐藏搜索框" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="UiHotkeyKeys" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="快速切换浮层" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="Ctrl" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="+" FontSize="10" Foreground="{ThemeResource Text4Brush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="G" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="未接入" FontSize="9.5" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="搜索窗口" Style="{StaticResource LpSectionLabelStyle}" Margin="0,20,0,6" />
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="打开选中结果" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="↵" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="Enter" FontSize="10" Foreground="{ThemeResource Text4Brush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="在资源管理器中显示" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="Ctrl" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="+" FontSize="10" Foreground="{ThemeResource Text4Brush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="↵" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="未接入" FontSize="9.5" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="切换搜索范围" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="Tab" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="未接入" FontSize="9.5" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="隐藏窗口" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource LpKbdStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="Esc" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="快速切换" Style="{StaticResource LpSectionLabelStyle}" Margin="0,20,0,6" />
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="数字键直选文件夹" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="1" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="–" FontSize="10" Foreground="{ThemeResource Text4Brush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="6" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,4">
                                    <TextBlock Text="确认跳转" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LpKbdStyle}"><TextBlock Text="↵" FontSize="9.5" Foreground="{ThemeResource Text2Brush}" /></Border>
                                        <TextBlock Text="Enter" FontSize="10" Foreground="{ThemeResource Text4Brush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource LpCardStyle}" Margin="0,20,0,0" Padding="12,10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="标为「未接入」的组合当前版本不会响应；唤出热键可在 config.json 的 uiHotkey 中修改。"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 搜索范围与索引 -->
                            <StackPanel x:Name="PageScope" Visibility="Collapsed">
                                <TextBlock Text="搜索范围与索引"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="只索引真正会用到的位置。排除规则优先于搜索范围。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

                                <TextBlock Text="搜索内容"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,4" />
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource Surface3Brush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#D7A03A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="本地文件与文件夹" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock x:Name="ScopeLocalDetail" Text="由后台服务提供 · 索引状态加载中" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="ScopeLocalSwitch" Grid.Column="2" IsOn="True" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource Surface3Brush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="13" Foreground="#9779F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="已安装程序" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                            <TextBlock Text="未接入" FontSize="9" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="当前版本只索引文件名，不含开始菜单与注册表" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="ScopeAppsSwitch" Grid.Column="2" IsOn="False" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource Surface3Brush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#3FAE95" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="浏览器历史与书签" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                            <TextBlock Text="未接入" FontSize="9" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="需要授权 Chrome / Edge 数据目录" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="ScopeBrowserSwitch" Grid.Column="2" IsOn="False" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource Surface3Brush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE968;" FontSize="13" Foreground="{ThemeResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="网络位置" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                            <TextBlock Text="未接入" FontSize="9" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="已映射的网络驱动器与 NAS" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="ScopeNetworkSwitch" Grid.Column="2" IsOn="False" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="索引位置"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,20,0,9" />
                                <StackPanel x:Name="IndexChipsPanel" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" />
                                
                                <TextBlock Text="排除规则"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,20,0,9" />
                                <StackPanel x:Name="ExcludeChipsPanel" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" />

                                <Border Style="{StaticResource LpCardStyle}" Margin="0,20,0,0" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock x:Name="StatEntriesText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
                                                <TextBlock Text="已索引项目" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock x:Name="StatSizeText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
                                                <TextBlock Text="索引文件大小" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="1">
                                                <TextBlock x:Name="StatStateText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
                                                <TextBlock Text="索引状态" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" />
                                            </StackPanel>
                                            <Button x:Name="RebuildButton"
                                                    Grid.Column="3"
                                                    Content="重建索引"
                                                    Style="{StaticResource LpGhostButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="OnRebuildClick" />
                                        </Grid>
                                        <Border Height="3" CornerRadius="2" Background="{ThemeResource Surface4Brush}">
                                            <Border x:Name="IndexProgressFill" Height="3" CornerRadius="2" Background="{ThemeResource AccentBrush}" Width="0" HorizontalAlignment="Left" />
                                        </Border>
                                        <TextBlock x:Name="IndexFootText"
                                                   Text="索引状态加载中…"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 更新 -->
                            <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                                <TextBlock Text="更新"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="检查 GitHub 上的最新版本，可下载或仅下载安装包。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

                                <Grid Margin="0,18,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="VersionDot"
                                            Width="30" Height="30" CornerRadius="8">
                                        <TextBlock x:Name="VersionMarkText"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="VersionLineText" Text="版本 1.0.1" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock x:Name="VersionSubText" Text="稳定通道" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource Surface3Brush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Ellipse Width="5" Height="5" Fill="{ThemeResource OkBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="VersionBadgeText" Text="已安装" FontSize="9.5" Foreground="{ThemeResource Text3Brush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="更新方式" Style="{StaticResource LpSectionLabelStyle}" Margin="0,24,0,4" />

                                <Grid Margin="0,10,0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="自动检查更新" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="启动时检查，并按检查频率复查" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="AutoCheckSwitch" Grid.Column="1" VerticalAlignment="Center" Toggled="OnAutoCheckToggled" />
                                </Grid>

                                <Grid Margin="0,10,0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="检查频率" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="仅影响检查，不影响下载" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <Button x:Name="FrequencyButton"
                                            Grid.Column="1"
                                            Style="{StaticResource LpSelectButtonStyle}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock x:Name="FrequencyText" Text="每天" FontSize="11" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="每天" Click="OnFrequencyDailyClick" />
                                                <MenuFlyoutItem Text="每周" Click="OnFrequencyWeeklyClick" />
                                                <MenuFlyoutItem Text="仅手动" Click="OnFrequencyManualClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,10,0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="更新通道" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="稳定版经过完整回归，预览版更新更频繁" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource LpSelectButtonStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="稳定版" FontSize="11" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="稳定版（当前）" IsEnabled="False" />
                                                <MenuFlyoutItem Text="预览版（未接入）" IsEnabled="False" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,10,0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="下载镜像" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="当前仅 GitHub 官方源" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource LpSelectButtonStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="GitHub 官方" FontSize="11" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="GitHub 官方（当前）" IsEnabled="False" />
                                                <MenuFlyoutItem Text="镜像（未接入）" IsEnabled="False" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,22,0,0">
                                    <Button Content="检查更新"
                                            Style="{StaticResource LpGhostButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Click="OnCheckUpdateClick" />
                                    <TextBlock x:Name="LastCheckText"
                                               Text="上次检查：尚未检查"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource Text3Brush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
