<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pathleap.UI.Controls">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="LpNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="10,1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="LpSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
            </Style>
            <Style x:Key="LpKbdStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="{ThemeResource Surface3Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="LpGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
            <Style x:Key="LpPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
            </Style>
            <Style x:Key="LpSelectButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
            </Style>
            <Style x:Key="LpCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border1Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏：左侧标题，右侧自绘按钮（最小化、关闭；固定尺寸窗不显示最大化） -->
                <Grid x:Name="CaptionBar" Grid.Row="0" Background="{ThemeResource CaptionBrush}"
                      PointerPressed="OnCaptionBarPressed">
                    <TextBlock Text="设置"
                               FontSize="12.5"
                               Foreground="{ThemeResource Text2Brush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <controls:CaptionButton x:Name="CaptionMinButton"
                                                Style="{StaticResource LpCaptionButtonStyle}"
                                                Kind="Minimize"
                                                ToolTipService.ToolTip="最小化"
                                                Click="OnCaptionMinimizeClick" />
                        <controls:CaptionButton x:Name="CaptionCloseButton"
                                                Style="{StaticResource LpCaptionButtonStyle}"
                                                Kind="Close"
                                                IsClose="True"
                                                ToolTipService.ToolTip="关闭"
                                                Click="OnCaptionCloseClick" />
                    </StackPanel>
                    <Border Height="1"
                            Background="{ThemeResource Border1Brush}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧分类 -->
                    <Border Background="{ThemeResource Surface2Brush}"
                            BorderBrush="{ThemeResource Border1Brush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Padding="16,16,16,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BrandDot"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="8"
                                        VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="ProductNameText"
                                               Text="Pathleap"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Text1Brush}" />
                                    <TextBlock Text="设置"
                                               FontSize="10"
                                               Foreground="{ThemeResource Text3Brush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <Button x:Name="NavAppearance"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavAppearanceClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                                        <TextBlock Text="外观与主题" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="行为"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="20,14,0,5" />

                                <Button x:Name="NavShortcuts"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavShortcutsClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE765;" FontSize="14" />
                                        <TextBlock Text="快捷键" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavScope"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavScopeClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="搜索范围与索引" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="系统"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="20,14,0,5" />

                                <Button x:Name="NavUpdate"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavUpdateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="更新" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavHelp"
                                        Style="{StaticResource LpNavButtonStyle}"
                                        Click="OnNavHelpClick">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                                        <TextBlock Text="帮助" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="16,0,16,14" Spacing="3">
                                <TextBlock x:Name="NavVersionText"
                                           Text="版本 1.0.1"
                                           FontSize="10.5"
                                           Foreground="{ThemeResource Text3Brush}" />
                                <Button Content="检查更新"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        FontSize="10.5"
                                        Foreground="{ThemeResource Text2Brush}"
                                        HorizontalAlignment="Left"
                                        Click="OnCheckUpdateClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧内容 -->
                    <ScrollViewer Grid.Column="1"
                                  x:Name="ContentScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Padding="26,18,26,26">
                            <!-- 外观与主题 -->
                            <StackPanel x:Name="PageAppearance">
                                <TextBlock Text="外观与主题"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="跟随系统观感，只保留真正影响效率的个性化。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

                                <TextBlock Text="主题"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,9" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ThemeLightCard"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeLightTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6" Background="#F1F4F9">
                                                <Border Width="104" Height="54"
                                                        Background="#FFFFFF"
                                                        CornerRadius="5"
                                                        BorderBrush="#1A101828"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Margin="9,8,9,7" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <Ellipse Width="5" Height="5" Fill="#3D6EF7" />
                                                            <Ellipse Width="5" Height="5" Fill="#C9CFDA" />
                                                            <Ellipse Width="5" Height="5" Fill="#C9CFDA" />
                                                        </StackPanel>
                                                        <Border Height="6" Width="62" CornerRadius="2" Background="#DDE3ED" HorizontalAlignment="Left" />
                                                        <Border Height="6" Width="38" CornerRadius="2" Background="#E9EDF3" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="浅色" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeLightRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ThemeDarkCard"
                                            Grid.Column="1"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeDarkTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6" Background="#171A21">
                                                <Border Width="104" Height="54"
                                                        Background="#1E222A"
                                                        CornerRadius="5"
                                                        BorderBrush="#26FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Margin="9,8,9,7" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <Ellipse Width="5" Height="5" Fill="#3D6EF7" />
                                                            <Ellipse Width="5" Height="5" Fill="#4A5160" />
                                                            <Ellipse Width="5" Height="5" Fill="#4A5160" />
                                                        </StackPanel>
                                                        <Border Height="6" Width="62" CornerRadius="2" Background="#343B49" HorizontalAlignment="Left" />
                                                        <Border Height="6" Width="38" CornerRadius="2" Background="#2A303C" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="深色" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeDarkRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ThemeSystemCard"
                                            Grid.Column="2"
                                            Style="{StaticResource LpCardStyle}"
                                            Tapped="OnThemeSystemTapped">
                                        <StackPanel>
                                            <Border Height="64" Margin="6,6,6,0" CornerRadius="6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F1F4F9" Offset="0" />
                                                        <GradientStop Color="#F1F4F9" Offset="0.5" />
                                                        <GradientStop Color="#171A21" Offset="0.5" />
                                                        <GradientStop Color="#171A21" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Border Width="58" Height="44" Background="#FFFFFF" CornerRadius="4" BorderBrush="#1A101828" BorderThickness="1" HorizontalAlignment="Left" Margin="16,10,0,0" VerticalAlignment="Center">
                                                        <StackPanel Margin="6,6" Spacing="3">
                                                            <Border Height="5" Width="34" CornerRadius="2" Background="#DDE3ED" HorizontalAlignment="Left" />
                                                            <Border Height="5" Width="24" CornerRadius="2" Background="#E9EDF3" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Width="58" Height="44" Background="#1E222A" CornerRadius="4" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Right" Margin="0,10,16,0" VerticalAlignment="Center">
                                                        <StackPanel Margin="6,6" Spacing="3">
                                                            <Border Height="5" Width="34" CornerRadius="2" Background="#343B49" HorizontalAlignment="Left" />
                                                            <Border Height="5" Width="24" CornerRadius="2" Background="#2A303C" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid Padding="10,7,10,9">
                                                <TextBlock Text="跟随系统" FontSize="12" Foreground="{ThemeResource Text1Brush}" />
                                                <Ellipse x:Name="ThemeSystemRadio"
                                                         Width="14" Height="14"
                                                         Stroke="{ThemeResource Border3Brush}"
                                                         StrokeThickness="1"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="配色方案"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,3" />
                                <TextBlock Text="一整套窗口、表面、文字、边框与状态色；与上方明暗独立组合，切换即时生效。"
                                           FontSize="10.5"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,0,0,9" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ColorThemeIndigo" Style="{StaticResource LpCardStyle}" Tapped="OnColorThemeTapped" Tag="indigo">
                                        <StackPanel>
                                            <Border Height="34" Margin="6,6,6,0" CornerRadius="5" Background="#171A21">
                                                <StackPanel Margin="7,6" Spacing="4">
                                                    <Border Height="5" Width="30" CornerRadius="2" Background="#3563E6" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="20" CornerRadius="2" Background="#A3ADBE" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Padding="9,6,9,8">
                                                <TextBlock Text="靛紫" FontSize="11.5" Foreground="{ThemeResource Text1Brush}" />
                                                <FontIcon x:Name="ColorThemeIndigoCheck" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ColorThemeViolet" Grid.Column="1" Style="{StaticResource LpCardStyle}" Tapped="OnColorThemeTapped" Tag="violet">
                                        <StackPanel>
                                            <Border Height="34" Margin="6,6,6,0" CornerRadius="5" Background="#17141F">
                                                <StackPanel Margin="7,6" Spacing="4">
                                                    <Border Height="5" Width="30" CornerRadius="2" Background="#6E52E8" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="20" CornerRadius="2" Background="#AFA6C4" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Padding="9,6,9,8">
                                                <TextBlock Text="紫罗兰" FontSize="11.5" Foreground="{ThemeResource Text1Brush}" />
                                                <FontIcon x:Name="ColorThemeVioletCheck" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ColorThemeAurora" Grid.Column="2" Style="{StaticResource LpCardStyle}" Tapped="OnColorThemeTapped" Tag="aurora">
                                        <StackPanel>
                                            <Border Height="34" Margin="6,6,6,0" CornerRadius="5" Background="#131A20">
                                                <StackPanel Margin="7,6" Spacing="4">
                                                    <Border Height="5" Width="30" CornerRadius="2" Background="#35C7E4" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="20" CornerRadius="2" Background="#9FB3BD" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Padding="9,6,9,8">
                                                <TextBlock Text="极光青" FontSize="11.5" Foreground="{ThemeResource Text1Brush}" />
                                                <FontIcon x:Name="ColorThemeAuroraCheck" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ColorThemeForest" Grid.Column="3" Style="{StaticResource LpCardStyle}" Tapped="OnColorThemeTapped" Tag="forest">
                                        <StackPanel>
                                            <Border Height="34" Margin="6,6,6,0" CornerRadius="5" Background="#141A17">
                                                <StackPanel Margin="7,6" Spacing="4">
                                                    <Border Height="5" Width="30" CornerRadius="2" Background="#3FBF8C" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="20" CornerRadius="2" Background="#A1B3A9" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Padding="9,6,9,8">
                                                <TextBlock Text="森野绿" FontSize="11.5" Foreground="{ThemeResource Text1Brush}" />
                                                <FontIcon x:Name="ColorThemeForestCheck" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ColorThemeEmber" Grid.Column="4" Style="{StaticResource LpCardStyle}" Tapped="OnColorThemeTapped" Tag="ember">
                                        <StackPanel>
                                            <Border Height="34" Margin="6,6,6,0" CornerRadius="5" Background="#1C1814">
                                                <StackPanel Margin="7,6" Spacing="4">
                                                    <Border Height="5" Width="30" CornerRadius="2" Background="#E6A24A" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="20" CornerRadius="2" Background="#B9ADA0" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Padding="9,6,9,8">
                                                <TextBlock Text="暖琥珀" FontSize="11.5" Foreground="{ThemeResource Text1Brush}" />
                                                <FontIcon x:Name="ColorThemeEmberCheck" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="窗口"
                                           Style="{StaticResource LpSectionLabelStyle}"
                                           Margin="0,22,0,9" />
                                <Grid ColumnSpacing="12" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="窗口不透明度" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="降低透明度可让桌面内容透出，建议搭配磨砂背景"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSlider x:Name="OpacitySlider"
                                                       Grid.Column="1"
                                                       Width="110"
                                                       VerticalAlignment="Center"
                                                       ValueChanged="OnOpacityChanged" />
                                    <TextBlock x:Name="OpacityValueText"
                                               Grid.Column="2"
                                               Text="92%"
                                               FontSize="11"
                                               Foreground="{ThemeResource Text2Brush}"
                                               MinWidth="34"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="12" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="磨砂背景" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="从壁纸采样颜色，减少纯色窗口的割裂感"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <controls:LpSwitch x:Name="AcrylicSwitch"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Toggled="OnAcrylicToggled" />
                                </Grid>

                                <Grid ColumnSpacing="12" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="结果列表密度" FontSize="12.5" Foreground="{ThemeResource Text1Brush}" />
                                        <TextBlock Text="紧凑模式显示更多结果，标准模式保留路径行"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Text3Brush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource Surface2Brush}"
                                            BorderBrush="{ThemeResource Border2Brush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Border x:Name="DensityCompact" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Compact">
                                                <TextBlock Text="紧凑" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                            <Border x:Name="DensityStandard" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Standard">
                                                <TextBlock Text="标准" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                            <Border x:Name="DensityComfortable" Padding="10,4" CornerRadius="5" Tapped="OnDensityTapped" Tag="Comfortable">
                                                <TextBlock Text="宽松" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 快捷键 -->
                            <StackPanel x:Name="PageShortcuts" Visibility="Collapsed">
                                <TextBlock Text="快捷键"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="全部操作可脱离鼠标完成。冲突时以系统级热键优先。"
                                           FontSize="11"
                                           Foreground="{ThemeResource Text3Brush}"
                                           Margin="0,5,0,0" />

