<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="RootBorder"
                Background="#F514171D"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 搜索栏 -->
                <Grid Grid.Row="0" Padding="18,16,18,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3D6EF7" Offset="0" />
                                <GradientStop Color="#7A5CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="BrandMarkText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="34"
                             VerticalAlignment="Center"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="#F2F4F8"
                             PlaceholderText="搜索文件、文件夹或程序…"
                             PlaceholderForeground="#737C8D"
                             SelectionHighlightColor="#4D3D6EF7"
                             IsSpellCheckEnabled="False"
                             TextWrapping="NoWrap" />

                    <Border Grid.Column="2"
                            Background="#14FFFFFF"
                            CornerRadius="6"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="M1 空壳"
                                   FontSize="10"
                                   Foreground="#98A2B3" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="18,0" />

                <!-- 分组标题 -->
                <Grid Grid.Row="2" Padding="20,12,20,4">
                    <TextBlock Text="最近访问"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#9AA4B5" />
                    <TextBlock Text="M1 占位"
                               FontSize="10"
                               Foreground="#616B7C"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- 空状态 -->
                <Grid Grid.Row="3" Padding="24,0,24,16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="12"
                                Background="#14FFFFFF"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="19"
                                      Foreground="#727EE8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="M1 骨架：搜索与索引尚未启用"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#C9D1DE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="全局热键唤出 · 托盘常驻 · 真实索引将在 M2 接入"
                                   FontSize="12"
                                   Foreground="#808A9B"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 底栏 -->
                <Border Grid.Row="4"
                        Height="42"
                        Background="#1C2029"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <Grid Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                            <TextBlock Text="↑↓ 选择" FontSize="11" Foreground="#7B8496" />
                            <TextBlock Text="↵ 打开" FontSize="11" Foreground="#7B8496" />
                            <TextBlock Text="Esc 隐藏" FontSize="11" Foreground="#7B8496" />
                            <TextBlock x:Name="VersionText" FontSize="11" Foreground="#586172" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="7">
                            <Ellipse x:Name="StatusDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#C77A18"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ServiceStatusText"
                                       Text="服务未连接 · 索引未启用"
                                       FontSize="11"
                                       Foreground="#98A2B3"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
