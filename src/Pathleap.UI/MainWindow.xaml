<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pathleap.UI"
    xmlns:controls="using:Pathleap.UI.Controls">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="LpToolButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
            </Style>
            <Style x:Key="LpKbdStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Border2Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Border x:Name="RootBorder"
                Background="#EB171A21"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 01 搜索栏 -->
                <Grid Grid.Row="0" Padding="18,18,18,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BrandDot"
                            Width="22"
                            Height="22"
                            CornerRadius="7"
                            VerticalAlignment="Center" />

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="30"
                             VerticalAlignment="Center"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource Text1Brush}"
                             PlaceholderText="搜索文件、文件夹或程序…"
                             PlaceholderForeground="{ThemeResource Text4Brush}"
                             SelectionHighlightColor="#4D3D6EF7"
                             IsSpellCheckEnabled="False"
                             TextWrapping="NoWrap"
                             AutomationProperties.Name="搜索框">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <Button x:Name="PinButton"
                                Style="{StaticResource LpToolButtonStyle}"
                                ToolTipService.ToolTip="固定窗口置顶"
                                AutomationProperties.Name="固定窗口"
                                Click="OnPinClick">
                            <FontIcon Glyph="&#xE718;" FontSize="15" />
                        </Button>
                        <Button x:Name="MoreButton"
                                Style="{StaticResource LpToolButtonStyle}"
                                ToolTipService.ToolTip="更多">
                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="设置" Click="OnOpenSettingsClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="快速切换（预览）" Click="OnOpenQuickSwitchClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="检查更新" Click="OnCheckUpdateClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE895;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="关于" Click="OnAboutClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource Border1Brush}" Margin="18,0" />

                <!-- 02 分组标题 -->
                <Grid Grid.Row="2" Padding="20,13,20,5">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <FontIcon x:Name="GroupIcon"
                                  Glyph="&#xE81C;"
                                  FontSize="13"
                                  Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="GroupLabelText"
                                   Text="最近访问"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="130"
                                   Foreground="{ThemeResource Text3Brush}" />
                    </StackPanel>

                    <Button x:Name="ClearHistoryButton"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            FontSize="11"
                            Foreground="{ThemeResource Text3Brush}"
                            Click="OnClearHistoryClick">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="清除历史" FontSize="11" />
                                <FontIcon Glyph="&#xE72A;" FontSize="11" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <TextBlock x:Name="ResultsCountText"
                               Text=""
                               FontSize="11"
                               Foreground="{ThemeResource Text3Brush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 03 结果 / 最近访问 -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ResultsScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,4,2,0">
                        <ItemsControl x:Name="ResultsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LpResultRow">
                                    <Border Height="{x:Bind RowHeight, Mode=OneWay}"
                                            Margin="0,0,0,1"
                                            Padding="10,0"
                                            CornerRadius="8"
                                            Background="{x:Bind RowBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                            BorderThickness="1"
                                            Tapped="OnRowTapped"
                                            PointerEntered="OnRowPointerEntered"
                                            PointerExited="OnRowPointerExited"
                                            AutomationProperties.Name="{x:Bind Name}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="7"
                                                    Background="{x:Bind IconBackground}"
                                                    BorderBrush="{x:Bind IconBorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontFamily="Segoe Fluent Icons"
                                                          FontSize="16"
                                                          Foreground="{x:Bind IconForeground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <controls:LpHighlightText RichText="{x:Bind Name, Mode=OneWay}"
                                                                          Query="{x:Bind Query, Mode=OneWay}"
                                                                          LabelFontSize="{x:Bind NameFontSize, Mode=OneWay}"
                                                                          LabelFontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                                          Foreground="{ThemeResource Text1Brush}" />
                                                <TextBlock Text="{x:Bind FolderPath}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource Text3Brush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind PathVisibility, Mode=OneWay}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TimeText}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource Text4Brush}"
                                                           MinWidth="46"
                                                           TextAlignment="Right"
                                                           Visibility="{x:Bind TimeVisibility, Mode=OneWay}" />

                                                <Border Background="{ThemeResource Surface2Brush}"
                                                        BorderBrush="{ThemeResource Border2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        Visibility="{x:Bind TagVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Tag}"
                                                               FontSize="9.5"
                                                               CharacterSpacing="50"
                                                               Foreground="{ThemeResource Text3Brush}" />
                                                </Border>

                                                <Border Width="22"
                                                        Height="20"
                                                        CornerRadius="5"
                                                        Background="{x:Bind EnterBackground, Mode=OneWay}"
                                                        Visibility="{x:Bind EnterVisibility, Mode=OneWay}">
                                                    <TextBlock Text="↵"
                                                               FontSize="10"
                                                               FontFamily="Segoe UI Symbol"
                                                               Foreground="{x:Bind EnterForeground, Mode=OneWay}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="12"
                                Background="{ThemeResource Surface3Brush}"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="EmptyIcon"
                                      Glyph="&#xE81C;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="19"
                                      Foreground="{ThemeResource Text3Brush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyTitleText"
                                   Text="还没有最近访问"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Text2Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyHintText"
                                   Text="打开任意搜索结果后，会出现在这里"
                                   FontSize="12"
                                   Foreground="{ThemeResource Text3Brush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 04 底栏：常驻键盘提示（按设计稿：9.5px 等宽键帽 + 10.5px 说明，13px 组间距） -->
                <Border Grid.Row="4"
                        Height="42"
                        Background="{ThemeResource Surface2Brush}"
                        BorderBrush="{ThemeResource Border1Brush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <Grid Padding="16,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Style="{StaticResource LpKbdStyle}" BorderThickness="1,1,1,2">
                                    <TextBlock Text="&#x2191;"
                                               FontFamily="Consolas"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource Text2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource LpKbdStyle}" BorderThickness="1,1,1,2">
                                    <TextBlock Text="&#x2193;"
                                               FontFamily="Consolas"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource Text2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="选择"
                                           FontSize="10.5"
                                           CharacterSpacing="10"
                                           Foreground="{ThemeResource Text3Brush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Style="{StaticResource LpKbdStyle}" BorderThickness="1,1,1,2">
                                    <TextBlock Text="&#x21B5;"
                                               FontFamily="Consolas"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource Text2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="打开"
                                           FontSize="10.5"
                                           CharacterSpacing="10"
                                           Foreground="{ThemeResource Text3Brush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Style="{StaticResource LpKbdStyle}" BorderThickness="1,1,1,2" MinWidth="25">
                                    <TextBlock Text="Esc"
                                               FontFamily="Consolas"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource Text2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="隐藏"
                                           FontSize="10.5"
                                           CharacterSpacing="10"
                                           Foreground="{ThemeResource Text3Brush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <Grid Width="11" Height="11" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusGlow"
                                         Width="11"
                                         Height="11"
                                         Opacity="0.16"
                                         Fill="{ThemeResource WarnBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Ellipse x:Name="StatusDot"
                                         Width="5"
                                         Height="5"
                                         Fill="{ThemeResource WarnBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ServiceStatusText"
                                       Text="正在连接索引服务…"
                                       FontSize="10"
                                       CharacterSpacing="10"
                                       Foreground="{ThemeResource Text3Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
