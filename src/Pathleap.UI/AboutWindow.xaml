<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pathleap.UI.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="RootBorder"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource Border2Brush}"
                BorderThickness="0"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="20,18,20,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BrandDot" Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                        <TextBlock x:Name="BrandMarkText"
                                   Text="名"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ProductNameText" Text="Pathleap" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
                        <TextBlock x:Name="ProductSubText" Text="Windows 快速定位工具" FontSize="10.5" Foreground="{ThemeResource Text3Brush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Padding="20,16,20,0" Spacing="7">
                    <Grid>
                        <TextBlock Text="版本" FontSize="11" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="VersionText" Text="1.0.1" FontSize="11" Foreground="{ThemeResource Text2Brush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="运行时" FontSize="11" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock Text=".NET 8 · Windows App SDK" FontSize="11" Foreground="{ThemeResource Text2Brush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="索引" FontSize="11" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="IndexStateText" Text="由后台服务提供" FontSize="11" Foreground="{ThemeResource Text2Brush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Padding="20,18,20,18">
                    <Button x:Name="HomeButton"
                            Content="打开主页"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="{ThemeResource Border2Brush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Height="30"
                            Padding="13,0"
                            FontSize="11.5"
                            Foreground="{ThemeResource Text2Brush}"
                            Click="OnHomeClick" />
                    <Button Content="关闭"
                            HorizontalAlignment="Right"
                            CornerRadius="7"
                            Height="30"
                            Padding="16,0"
                            FontSize="11.5"
                            Click="OnCloseClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
