<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pathleap.ReleaseTool</RootNamespace>
    <AssemblyName>Pathleap.ReleaseTool</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 只用于发布流水线与本地 dry-run，不随安装包分发。 -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pathleap.Shared\Pathleap.Shared.csproj" />
  </ItemGroup>
</Project>
